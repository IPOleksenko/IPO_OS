#ifndef _CPP_STRING_H
#define _CPP_STRING_H

#include <stddef.h>
#include <string.h>
#include <stdlib.h>
#include <iostream>

namespace std {

class string {
private:
    char *m_data;
    size_t m_len;
public:
    string() : m_data(nullptr), m_len(0) {
        m_data = (char *)malloc(1);
        if (m_data) m_data[0] = '\0';
    }

    string(const char *s) : m_data(nullptr), m_len(0) {
        if (s) {
            m_len = strlen(s);
            m_data = (char *)malloc(m_len + 1);
            if (m_data) strcpy(m_data, s);
        } else {
            m_data = (char *)malloc(1);
            if (m_data) m_data[0] = '\0';
        }
    }

    string(const string &other) : m_data(nullptr), m_len(other.m_len) {
        m_data = (char *)malloc(m_len + 1);
        if (m_data && other.m_data) strcpy(m_data, other.m_data);
    }

    ~string() {
        if (m_data) free(m_data);
    }

    string& operator=(const string &other) {
        if (this != &other) {
            if (m_data) free(m_data);
            m_len = other.m_len;
            m_data = (char *)malloc(m_len + 1);
            if (m_data && other.m_data) strcpy(m_data, other.m_data);
        }
        return *this;
    }

    size_t length() const { return m_len; }
    size_t size() const { return m_len; }
    bool empty() const { return m_len == 0; }
    const char* c_str() const { return m_data ? m_data : ""; }

    char& operator[](size_t idx) { return m_data[idx]; }
    const char& operator[](size_t idx) const { return m_data[idx]; }
};

inline ostream& operator<<(ostream& os, const string& s) {
    return os << s.c_str();
}

} // namespace std

#endif

